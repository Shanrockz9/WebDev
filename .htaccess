# Disable directory listings (prevents clients from browsing folders in XAMPP)
Options -Indexes

# Protect sensitive database files and documentation
<FilesMatch "\.(sql|md|json|lock|git|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect internal architecture directories from direct web requests
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>
